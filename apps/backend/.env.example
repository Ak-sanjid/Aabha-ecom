# ---------------------------------------------------------------------------
# Aabha backend — copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=4000
API_PREFIX=api
APP_NAME=Aabha
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://aabha:aabha@127.0.0.1:5433/aabha

# Redis — cache, guest-cart persistence, BullMQ queues.
# Leave empty to fall back to the in-process driver (dev only).
REDIS_URL=

# Auth / JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_DOMAIN=localhost
BCRYPT_ROUNDS=10

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# OAuth — Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/v1/auth/facebook/callback

# OTP / SMS gateway (provider is swappable behind an interface)
# console | twilio | bulksmsbd | alpha_sms
SMS_PROVIDER=console
SMS_SENDER_ID=AABHA
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
BULKSMSBD_API_KEY=
ALPHA_SMS_API_KEY=

# WhatsApp Cloud API (order verification, notifications)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Email (transactional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Aabha <no-reply@aabha.com.bd>"

# S3-compatible media storage
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=aabha-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Payment gateways
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
ROCKET_MERCHANT_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Couriers (keys are normally entered in the admin "Connect" box and stored
# encrypted in the DB; these are fallbacks for local development only)
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
REDX_API_TOKEN=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
CARRYBEE_API_KEY=

# Marketing & analytics
FACEBOOK_PIXEL_ID=
FACEBOOK_CAPI_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GOOGLE_MERCHANT_CENTER_ID=

# LLM (AI assistant, AI product copy, translations)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Encryption key for credentials stored in the DB (32 bytes, base64)
CREDENTIALS_ENCRYPTION_KEY=
