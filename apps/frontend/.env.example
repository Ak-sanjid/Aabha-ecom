# ---------------------------------------------------------------------------
# Aabha frontend — copy to `.env.local`. NEVER commit the real file.
# ---------------------------------------------------------------------------

# Where the Next.js server proxies /api/* to (server-side only).
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# Public site URL, used for canonical tags, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default locale for first-time visitors: en | bn
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Marketing & analytics (Milestone 5)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Media CDN base for product images
NEXT_PUBLIC_MEDIA_BASE_URL=
